{
	"schemaVersion": 1,
	"id": "bot-phantom-blocker",
	"version": "${version}",
	"name": "Bot Phantom Blocker",
	"description": "Stops Carpet bots from spawning phantoms by resetting their rest timer. Real players are not affected.",
	"authors": ["Martin"],
	"contact": {
		"sources": "https://github.com/Moma2612/phantom-blocker",
		"issues": "https://github.com/Moma2612/phantom-blocker/issues"
	},
	"license": "MIT",
	"icon": "assets/bot-phantom-blocker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["de.martin.botphantomblocker.BotPhantomBlocker"]
	},
	"mixins": ["bot-phantom-blocker.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": {
		"carpet": "*"
	}
}
